# Copia este archivo a .env y ajusta los valores — .env nunca se sube a Git

APP_NAME=pdc-lab
SCHEMA_NAME=pdc_app_pdc_lab
DB_MODE=sqlite
DATABASE_URL=sqlite:///./data/app.db
SECRET_KEY=local-dev-key

ADMIN_ACCESS_CODE=cambiar-esta-clave
POWER_AUTOMATE_WEBHOOK_URL=

